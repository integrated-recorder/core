{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated-recorder.invalid/schemas/plugin-registry-v3.schema.json",
  "title": "Integrated Recorder Plugin Registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 3},
    "plugins": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"},
    "artifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "url", "filename", "size", "sha256"],
      "properties": {
        "os": {"enum": ["linux", "darwin"]},
        "arch": {"enum": ["amd64", "arm64"]},
        "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://[^/@?#]+/[^#]*$"},
        "filename": {
          "$comment": "Runtime validation also requires integrated-recorder-adapter-<plugin.id> for source plugins or integrated-recorder-storage-<plugin.id> for storage plugins.",
          "type": "string", "minLength": 29, "maxLength": 92
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "publisher", "name", "repository", "channels", "releases"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "type": {"enum": ["source", "storage"]},
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"enum": ["first_party", "third_party"]}}
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "repository": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https://[^/@?#]+/[^?#]+$"},
        "channels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "additionalProperties": false,
          "properties": {
            "stable": {"$ref": "#/$defs/identity"},
            "beta": {"$ref": "#/$defs/identity"},
            "development": {"$ref": "#/$defs/identity"}
          }
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/release"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "storage"}}, "required": ["type"]},
          "then": {
            "properties": {
              "id": {"not": {"const": "local"}},
              "releases": {"items": {"properties": {"protocol": {"properties": {"name": {"const": "storage"}}}}}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "source"}}, "required": ["type"]},
          "then": {
            "properties": {
              "id": {"not": {"const": "hls"}},
              "releases": {"items": {"properties": {"protocol": {"properties": {"name": {"const": "source"}}}}}}
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "protocol", "source_commit", "artifacts"],
      "properties": {
        "version": {"$ref": "#/$defs/identity"},
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"enum": ["source", "storage"]},
            "version": {"const": 1}
          }
        },
        "source_commit": {"type": "string", "minLength": 7, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{6,127}$"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"protocol": {"properties": {"name": {"const": "storage"}}, "required": ["name"]}}, "required": ["protocol"]},
          "then": {"properties": {"artifacts": {"items": {"allOf": [{"$ref": "#/$defs/artifactBase"}, {"properties": {"filename": {"type": "string", "pattern": "^integrated-recorder-storage-[a-z0-9][a-z0-9._-]*$"}}}]}}}}
        },
        {
          "if": {"properties": {"protocol": {"properties": {"name": {"const": "source"}}, "required": ["name"]}}, "required": ["protocol"]},
          "then": {"properties": {"artifacts": {"items": {"allOf": [{"$ref": "#/$defs/artifactBase"}, {"properties": {"filename": {"type": "string", "pattern": "^integrated-recorder-adapter-[a-z0-9][a-z0-9._-]*$"}}}]}}}}
        }
      ]
    },
    "artifact": {"$ref": "#/$defs/artifactBase"}
  }
}
