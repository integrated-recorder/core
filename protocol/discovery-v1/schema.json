{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated-recorder.github.io/protocol/discovery-v1/advertisement.schema.json",
  "title": "Integrated Recorder NodeAdvertisement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "advertisement_version",
    "global_identity_hint",
    "identity_head_hash",
    "node_id",
    "node_public_key",
    "sequence",
    "issued_at",
    "expires_at",
    "address_envelope",
    "capabilities",
    "relay_ids"
  ],
  "properties": {
    "advertisement_version": { "const": "ir.node.advertisement/1" },
    "global_identity_hint": { "type": "string", "pattern": "^gih_[A-Za-z0-9_-]{22}$" },
    "identity_head_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "node_id": { "type": "string", "pattern": "^nd_[A-Za-z0-9_-]{22}$" },
    "node_public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "sequence": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "address_envelope": { "type": "string", "minLength": 43, "maxLength": 21846, "pattern": "^[A-Za-z0-9_-]+$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["webrtc-datachannel/1", "turn-udp/1", "turn-tcp/1", "turn-tls/1"] }
    },
    "relay_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^rly_[A-Za-z0-9_-]{16,64}$" }
    }
  }
}
