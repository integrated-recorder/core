{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated-recorder.dev/protocol/peer-command-v1/schema.json",
  "title": "Integrated Recorder authenticated peer command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_version", "request_id", "session_id", "source_identity_id",
    "source_head_hash", "source_node_id", "target_identity_id", "target_node_id",
    "owner_subject_id", "archive_id", "action", "issued_at", "expires_at",
    "nonce", "payload_hash", "grant_chain", "payload", "signature"
  ],
  "properties": {
    "command_version": { "const": "ir.peer-command/1" },
    "request_id": { "type": "string", "pattern": "^pc_[A-Za-z0-9_-]{22}$" },
    "session_id": { "type": "string", "pattern": "^ps_[A-Za-z0-9_-]{22}$" },
    "source_identity_id": { "type": "string", "pattern": "^gi_[A-Za-z0-9_-]{22}$" },
    "source_head_hash": { "$ref": "#/$defs/hash" },
    "source_node_id": { "type": "string", "pattern": "^nd_[A-Za-z0-9_-]{22}$" },
    "target_identity_id": { "type": "string", "pattern": "^gi_[A-Za-z0-9_-]{22}$" },
    "target_node_id": { "type": "string", "pattern": "^nd_[A-Za-z0-9_-]{22}$" },
    "owner_subject_id": { "type": "string", "pattern": "^os_[A-Za-z0-9_-]{22}$" },
    "archive_id": { "type": "string", "pattern": "^arc_[A-Za-z0-9_-]{22}$" },
    "snapshot_id": { "type": "string", "pattern": "^snap_[a-f0-9]{64}$" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9.]{2,63}$" },
    "issued_at": { "$ref": "#/$defs/utcSecond" },
    "expires_at": { "$ref": "#/$defs/utcSecond" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "payload_hash": { "$ref": "#/$defs/hash" },
    "grant_chain": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "$ref": "#/$defs/signedGrant" }
    },
    "payload": {},
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utcSecond": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["identity", "node"] },
        "id": { "type": "string", "pattern": "^(gi|nd)_[A-Za-z0-9_-]{22}$" }
      }
    },
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_version", "subject_id", "issuer", "audience", "archive_id", "actions", "not_before", "expires_at", "delegation_depth", "nonce", "policy_epoch", "issuer_key_id"],
      "properties": {
        "grant_version": { "const": "ir.capability.grant/1" },
        "subject_id": { "type": "string", "pattern": "^os_[A-Za-z0-9_-]{22}$" },
        "issuer": { "$ref": "#/$defs/principal" },
        "audience": { "$ref": "#/$defs/principal" },
        "archive_id": { "type": "string", "pattern": "^arc_[A-Za-z0-9_-]{22}$" },
        "snapshot_id": { "type": "string", "pattern": "^snap_[a-f0-9]{64}$" },
        "actions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string" } },
        "not_before": { "$ref": "#/$defs/utcSecond" },
        "expires_at": { "$ref": "#/$defs/utcSecond" },
        "delegation_depth": { "type": "string", "pattern": "^(0|[1-8])$" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "parent_grant_hash": { "$ref": "#/$defs/hash" },
        "policy_epoch": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})$" },
        "issuer_key_id": { "type": "string", "pattern": "^ik_[A-Za-z0-9_-]{43}$" }
      }
    },
    "signedGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["grant", "signature"],
      "properties": {
        "grant": { "$ref": "#/$defs/grant" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
